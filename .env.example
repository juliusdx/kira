# Cloud sync is OPT-IN. Without these two vars Kira runs purely local-first
# (bundled content + IndexedDB) and every sync entry point is a no-op.
#
# Both values are safe to expose in a client bundle — they end up in the
# shipped JavaScript either way. Row Level Security is the actual boundary.
# NEVER put the service_role key here: it bypasses RLS entirely.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# TWO PROJECTS: production and dev
# ---------------------------------------------------------------------------
# `.env` above is PRODUCTION — the project holding real learner progress. Vite
# loads `.env` in every mode, so anything more specific wins over it:
#
#   .env.test.local          -> `npm run test:integration` (vitest runs as MODE=test)
#   .env.development.local   -> `npm run dev`
#
# Put the DEV project's url + publishable key in those two, and neither the
# integration suite nor the dev server ever touches production again. Both are
# gitignored by `*.local`.
#
# The guard in front of `npm run test:integration` reads whichever file wins
# and REFUSES without KIRA_ALLOW_PROD_TESTS=1 when the target is the
# production ref — and only then. Against a dev project it just runs, because
# a guard that fires on the safe case gets routed around. An UNKNOWN target
# counts as production; see scripts/prod-test-guard.mjs.
#
# To bootstrap a fresh dev project, paste supabase/maintenance/
# bootstrap_new_project.sql — all 9 migrations, one block. Do NOT run it
# against production, which already has them.
