# Vite mode `localonly` — blanks the Supabase vars that `.env` sets, so the app
# runs purely local-first and never signs in. Used for browser verification
# without minting yet another throwaway anonymous user on the production
# project. Committed on purpose: it holds no secrets, and without it
# `--mode localonly` would quietly fall back to the real `.env`.
#
#   npm run dev -- --mode localonly
#
# (or the `dev-local-only` entry in .claude/launch.json)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_VAPID_PUBLIC_KEY=
